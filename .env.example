# ACT Environment Configuration Template
# Duplicate this file to .env and provide your deployment secrets.

# Backend Configuration
PROJECT_NAME="ACT — Actionable Crisis Translator"
ENVIRONMENT=production
DEMO_MODE=true
SECRET_KEY=change_this_to_a_random_cryptographically_secure_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
# PostgreSQL example: postgresql://username:password@localhost:5432/act_db
# Neon / Supabase example: postgresql://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./act.db

# CORS Configuration (comma-separated allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://act-emergency.vercel.app"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://127.0.0.1:8000/api

# Docker PostgreSQL Variables
POSTGRES_USER=act_admin
POSTGRES_PASSWORD=act_secure_password_2026
POSTGRES_DB=act_db
