# Backend Environment Variables
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM API Key (System uses deterministic zero-hallucination fallback if not provided)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Database (Optional for Demo Mode; SQLite / in-memory fallback enabled by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/act_emergency

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
